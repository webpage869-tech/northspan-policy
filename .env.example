# Copy to .env on the server (same folder as docker-compose.yml), fill in, then: chmod 600 .env
# Never commit the real .env.

# Claude API key from the Claude Console (key name: policy-checker-prod)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# Checks__DailyLimit=200
# Ai__CheckModel=claude-haiku-5-5
# Checkout__Enabled=false
