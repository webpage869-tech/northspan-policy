# Copy to .env on the server (same folder as docker-compose.yml), fill in, then: chmod 600 .env
# Never commit the real .env. Each line is NAME=value with no spaces around the =.

# Claude API key from the Claude Console (key name: policy-checker-prod)
ANTHROPIC_API_KEY=

# Sign-up notification email (Zoho). Leave out to turn email off; sign-ups are still saved.
# Use a Zoho mailbox you log in to (not a group address) and a Zoho app-specific password, never your real password.
Smtp__Host=smtp.zoho.com
Smtp__Port=587
Smtp__User=
Smtp__Password=
# Who receives "New PolicyKit sign-up" emails (default info@northspanltd.com)
Notify__OwnerEmail=info@northspanltd.com
# Also send the visitor a "You're on the list" email (true/false). Off until the wording is approved.
Notify__SendConfirmation=false

# Optional overrides (defaults shown)
# Checks__DailyLimit=200
# Ai__CheckModel=claude-haiku-5-5
# Checkout__Enabled=false
